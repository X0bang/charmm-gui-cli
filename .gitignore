# Public repository allowlist. All other local files stay private.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/release.yml
!/.github/workflows/tests.yml
!/README.md
!/CHANGELOG.md
!/LICENSE
!/RESEARCH.md
!/pyproject.toml
!/install.sh
!/charmm_gui_cli/
/charmm_gui_cli/*
!/charmm_gui_cli/*.py
!/charmm_gui_cli/commands/
!/charmm_gui_cli/pipeline/
!/charmm_gui_cli/remote/
!/charmm_gui_cli/chem/
!/charmm_gui_cli/store/
!/charmm_gui_cli/locales/
/charmm_gui_cli/*/*
!/charmm_gui_cli/*/*.py
!/tests/
/tests/*
!/tests/test_*.py
!/scripts/
/scripts/*
!/scripts/build_release.py
!/scripts/install_user.py
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/ADVANCED.md
!/docs/TESTING.md
!/docs/USAGE.md
!/docs/BATCH.md
!/docs/CONVERSION.md
!/docs/RECOVERY.md
!/docs/SWEEP.md
!/docs/PREVIEW.md
!/docs/COMPONENTS.md
!/docs/I18N-TODO.md
!/examples/
/examples/*
!/examples/crtw-build.yaml
!/examples/crtw-beta-carotene.yaml
!/examples/membrane-ligand.yaml
!/examples/batch.yaml
!/examples/sweep.yaml
!/examples/components.yaml
!/examples/default-build.yaml
!/download/
/download/*
!/download/README.md
