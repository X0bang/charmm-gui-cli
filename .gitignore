# Public repository allowlist. All other local files stay private.
/*
!/.gitignore
!/README.md
!/RESEARCH.md
!/pyproject.toml
!/install.sh
!/charmm_gui_cli/
/charmm_gui_cli/*
!/charmm_gui_cli/*.py
!/tests/
/tests/*
!/tests/test_*.py
!/scripts/
/scripts/*
!/scripts/build_release.py
!/scripts/install_user.py
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/ADVANCED.md
!/docs/TESTING.md
!/docs/USAGE.md
!/examples/
/examples/*
!/examples/crtw-build.yaml
!/examples/crtw-beta-carotene.yaml
!/examples/membrane-ligand.yaml
